{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CountryData",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z-]+$"
    },
    "visualAssets": {
      "type": ["object", "null"],
      "properties": {
        "outlineSrc": { "type": "string" },
        "outlineAlt": { "type": "string" },
        "mapSrc": { "type": "string" },
        "mapAlt": { "type": "string" },
        "mapMarker": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "label": { "type": "string" }
          },
          "required": ["x", "y", "label"]
        },
        "source": { "type": "string" }
      },
      "required": ["outlineSrc", "outlineAlt", "mapSrc", "mapAlt", "mapMarker", "source"]
    },
    "catalog": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "flag": { "type": "string" },
        "name": { "type": "string" },
        "iso2": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "iso3": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "continent": { "type": "string" },
        "region": { "type": "string" },
        "language": { "type": "string" },
        "currency": { "type": "string" },
        "currencyName": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "inProgress", "planned", "comingSoon"] },
        "summary": { "type": "string" },
        "identifiers": { "type": "array", "items": { "type": "string" } },
        "payments": { "type": "array", "items": { "type": "string" } },
        "features": { "type": "array", "items": { "type": "string" } },
        "availableWorkbenches": { "type": "array", "items": { "type": "string" } },
        "plannedWorkbenches": { "type": "array", "items": { "type": "string" } },
        "completion": { "type": "integer" },
        "coordinates": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          },
          "required": ["x", "y"]
        }
      },
      "required": [
        "id", "flag", "name", "iso2", "iso3", "continent", "region", "language",
        "currency", "currencyName", "status", "summary", "identifiers", "payments",
        "features", "availableWorkbenches", "plannedWorkbenches", "completion", "coordinates"
      ]
    },
    "hub": {
      "type": ["object", "null"],
      "properties": {
        "flag": { "type": "string" },
        "name": { "type": "string" },
        "badge": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "type": "object" },
        "stats": { "type": "array" },
        "countryProfile": { "type": "array" },
        "visualIdentity": {
          "type": "object",
          "properties": {
            "countryId": { "type": "string" },
            "outlineLabel": { "type": "string" },
            "mapLabel": { "type": "string" },
            "continentBadge": { "type": "string" },
            "flagLabel": { "type": "string" },
            "heroAccentPrimary": { "type": "string" },
            "heroAccentSecondary": { "type": "string" },
            "heroAccentTertiary": { "type": "string" }
          },
          "required": [
            "countryId", "outlineLabel", "mapLabel", "continentBadge", "flagLabel",
            "heroAccentPrimary", "heroAccentSecondary", "heroAccentTertiary"
          ]
        }
      },
      "required": [
        "flag", "name", "badge", "description", "metadata", "stats", "countryProfile",
        "visualIdentity"
      ]
    }
  },
  "required": ["id", "visualAssets", "catalog", "hub"]
}
