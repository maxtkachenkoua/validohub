{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeEntity",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z-]+:[a-z0-9-]+$" },
    "type": { "type": "string", "enum": ["country", "identifier", "payment-system", "banking-standard", "authority", "workbench", "tool"] },
    "name": { "type": "string" },
    "shortDefinition": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "stableReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string" }
        },
        "required": ["label", "url"]
      }
    },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "contentVersion": { "type": "string" },
    "verificationStatus": { "type": "string", "enum": ["draft", "researched", "reviewed", "verified", "deprecated"] },
    "reviewPolicy": { "type": "string", "enum": ["static", "volatile", "stable"] },
    "recommendedReviewInterval": { "type": "integer" },
    "lastReviewedAt": { "type": "string" },
    "provenance": {
      "type": "object",
      "properties": {
        "sourceId": { "type": "string" },
        "sourceIds": { "type": "array", "items": { "type": "string" } },
        "reviewer": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  },
  "required": ["id", "type", "name", "createdAt", "updatedAt", "schemaVersion", "contentVersion", "verificationStatus", "reviewPolicy", "recommendedReviewInterval", "lastReviewedAt"]
}
