{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeRelationship",
  "type": "object",
  "properties": {
    "source": { "type": "string", "pattern": "^[a-z-]+:[a-z0-9-]+$" },
    "type": { "type": "string", "enum": ["USES_IDENTIFIER", "SUPPORTS_PAYMENT_SYSTEM", "PARTICIPATES_IN", "GOVERNED_BY", "VALIDATES", "IMPLEMENTS", "PUBLISHES_REFERENCE_FOR"] },
    "target": { "type": "string", "pattern": "^[a-z-]+:[a-z0-9-]+$" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": { "type": "string" },
          "sourceIds": { "type": "array", "items": { "type": "string" } },
          "evidenceStrength": { "type": "string", "enum": ["weak", "moderate", "strong", "authoritative"] },
          "sourceAuthorityLevel": { "type": "string", "enum": ["community", "secondary", "standards-body", "government", "official-registry"] },
          "interpretationConfidence": { "type": ["string", "number"] },
          "verificationMethod": { "type": "string" },
          "verifiedAt": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["verifiedAt"]
      }
    }
  },
  "required": ["source", "type", "target"]
}
